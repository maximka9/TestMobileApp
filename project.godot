config_version=5

[application]
config/name="SASAclicker"
config/version="0.9.0"
run/main_scene="res://src/features/stream/scenes/main_game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.028, 0.035, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[input_devices]
pointing/emulate_mouse_from_touch=true

[debug]
gdscript/warnings/untyped_declaration=1
gdscript/warnings/treat_warnings_as_errors=true
